{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chunking strategies of the brochure (config/strategies.yaml)",
  "type": "object",
  "required": ["strategies"],
  "additionalProperties": false,
  "properties": {
    "strategies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/strategy" }
    }
  },
  "$defs": {
    "strategy": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
        "type": { "enum": ["section", "split", "page"] },
        "parameters": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "section" } } },
          "then": {
            "properties": {
              "parameters": {
                "additionalProperties": false,
                "properties": {
                  "max_chars": { "type": "integer", "minimum": 200 },
                  "overlap": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "split" } } },
          "then": {
            "required": ["parameters"],
            "properties": {
              "parameters": {
                "required": ["chunk_size", "chunk_overlap"],
                "additionalProperties": false,
                "properties": {
                  "chunk_size": { "type": "integer", "minimum": 50 },
                  "chunk_overlap": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "page" } } },
          "then": {
            "properties": { "parameters": { "maxProperties": 0 } }
          }
        }
      ]
    }
  }
}
