# Copy to .env and adjust. The values below are the defaults used when the variable is not set.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
# Thinking of qwen3 chat models: off (default) or on. On is a bit more right, about 5 times slower and can end empty.
# OLLAMA_THINKING=off

# Grounded answers: the model quotes the knowledge and the code checks the quote before answering. Off (empty) by default.
# RAG_GROUNDED=on

# Support check, only with RAG_GROUNDED: one more model call checks that the quote states the answer; if not, the
# refusal is given (status "unsupported"). It doubles the model calls of an answer. Off (empty) by default.
# RAG_VERIFY_SUPPORT=on

# The knowledge from the Node server instead of the file: GET this URL with the bearer token INTERNAL_TOKEN.
# Also the token of POST /reindex; empty (default) turns that route off.
# KNOWLEDGE_URL=http://127.0.0.1:3000/internal/knowledge
# INTERNAL_TOKEN=
# The clinic's name and kind from the Node server (GET /internal/clinic, same token); the YAML profile keeps the rest.
# CLINIC_URL=http://127.0.0.1:3000/internal/clinic

# Model that judges the behaviour criteria in the evaluation. Without this variable, the chat model is used.
# OLLAMA_JUDGE_MODEL=qwen3:8b
