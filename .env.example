# Servidor
PORT=3000
PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info

# Banco de dados (docker compose up -d)
DATABASE_URL=postgres://secretaryfy:secretaryfy@localhost:5434/secretaryfy

# Chave de 32 bytes em base64 para criptografar tokens do Google e assinar links de OAuth
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=

# Google OAuth (console.cloud.google.com > APIs e serviços > Credenciais)
# URI de redirecionamento autorizado: ${PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=secretaryfy
# A mesma chave vai para AUTHENTICATION_API_KEY da Evolution no docker-compose.yml
# Endereço do servidor visto de dentro do Docker (a Evolution chama o webhook por ele). Sem a variável, usa PUBLIC_URL.
WEBHOOK_BASE_URL=http://host.docker.internal:3000
# Segredo usado na URL do webhook: ${WEBHOOK_BASE_URL}/webhooks/evolution?token=...
EVOLUTION_WEBHOOK_TOKEN=

# Serviço RAG (rag/, ver README)
RAG_SERVICE_URL=http://127.0.0.1:8001
# Tempo limite da chamada ao assistente, em ms (cobre o carregamento do modelo no Ollama)
RAG_TIMEOUT_MS=30000

# Painel web (http://localhost:5173 em desenvolvimento)
# Senha única do operador, com 12 caracteres ou mais. Sem ela, o painel fica desligado.
OPERATOR_PASSWORD=
# Banco para os testes do repositório (opcional; sem ele os testes usam um Postgres em memória)
# DATABASE_URL_TEST=postgres://secretaryfy:secretaryfy@localhost:5434/secretaryfy_test

# Claude API
ANTHROPIC_API_KEY=

# Agendamento (Google Agenda + Ollama)
# Ollama local que interpreta as mensagens do cliente; o modelo precisa estar baixado (ollama pull llama3)
OLLAMA_URL=http://127.0.0.1:11434
AGENT_MODEL=llama3
# Tempo limite da interpretação, em ms
AGENT_TIMEOUT_MS=20000
# Endereço do painel para onde o Google volta depois da autorização. Sem a variável, usa PUBLIC_URL.
# Em desenvolvimento o painel roda no Vite:
PANEL_URL=http://localhost:5173

# Proteção do número contra banimento (specs/004). Todas têm padrão; descomente só o que quiser mudar.
# Quando a mensagem do cliente aparece como visualizada, contado da última mensagem dele, em ms
# ANTIBAN_READ_MIN_MS=2000
# ANTIBAN_READ_MAX_MS=8000
# Pausa entre visualizar e começar a digitar, em ms (cresce com o tamanho da mensagem do cliente)
# ANTIBAN_THINK_MIN_MS=1000
# ANTIBAN_THINK_MAX_MS=3000
# Tempo de "digitando…" antes de cada resposta, em ms
# ANTIBAN_TYPING_MIN_MS=2000
# ANTIBAN_TYPING_MAX_MS=12000
# Silêncio do cliente antes de responder (mensagens seguidas viram uma resposta), em ms
# ANTIBAN_DEBOUNCE_MS=4000
# Limites de envio do número (assistente + operador)
# ANTIBAN_PER_MINUTE=8
# ANTIBAN_PER_HOUR=200
# ANTIBAN_GAP_MIN_MS=2000
# ANTIBAN_GAP_MAX_MS=6000
# Conversas diferentes atendidas pelo assistente em 24 h
# ANTIBAN_CONVERSATIONS_PER_DAY=150
# Tempo máximo de uma resposta na fila, em ms
# ANTIBAN_QUEUE_MAX_AGE_MS=300000
# Insistência e laço com outro robô
# ANTIBAN_MAX_UNANSWERED=3
# ANTIBAN_LOOP_FAST_REPLY_MS=3000
# ANTIBAN_LOOP_FAST_REPLIES=5
# ANTIBAN_LOOP_BURST=20
# ANTIBAN_LOOP_BURST_WINDOW_MS=600000
# Texto repetido para o mesmo cliente, em ms
# ANTIBAN_DUPLICATE_WINDOW_MS=1800000
# Domínios que o assistente pode mandar em links, separados por vírgula (ex.: dentalsafe.com.br)
# ANTIBAN_ALLOWED_LINK_DOMAINS=
# Aquecimento de número novo (0 desliga)
# ANTIBAN_WARMUP_DAYS=14
# ANTIBAN_WARMUP_CONVERSATIONS_PER_DAY=30
# ANTIBAN_WARMUP_PER_MINUTE=4
# Intervalo mínimo entre reenvios da mesma mensagem pelo painel, em ms
# ANTIBAN_RETRY_MIN_INTERVAL_MS=30000
# Freio automático: falhas ou quedas numa janela pausam os envios automáticos
# ANTIBAN_BREAKER_FAILURES=5
# ANTIBAN_BREAKER_FAILURE_WINDOW_MS=600000
# ANTIBAN_BREAKER_DROPS=3
# ANTIBAN_BREAKER_DROP_WINDOW_MS=1800000
# ANTIBAN_BREAKER_PAUSE_MS=1800000
# Pedidos de QR code por janela
# ANTIBAN_QR_ATTEMPTS=5
# ANTIBAN_QR_WINDOW_MS=600000
